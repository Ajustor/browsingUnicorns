<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in by scripts/build-macos-app.sh. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>@NAME@</string>
  <key>CFBundleDisplayName</key>
  <string>@NAME@</string>
  <key>CFBundleExecutable</key>
  <string>@EXE@</string>
  <key>CFBundleIdentifier</key>
  <string>@BUNDLE_ID@</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <!-- Without them macOS ends the app as soon as a site asks for the
       camera, the microphone or the location. -->
  <key>NSCameraUsageDescription</key>
  <string>Les sites que vous autorisez peuvent utiliser la caméra (visioconférence…). / Sites you allow can use the camera (video calls…).</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Les sites que vous autorisez peuvent utiliser le micro (appels…). / Sites you allow can use the microphone (calls…).</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Les sites que vous autorisez peuvent connaître votre position. / Sites you allow can know your location.</string>
</dict>
</plist>
